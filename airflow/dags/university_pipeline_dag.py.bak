# airflow/dags/university_pipeline_dag.py
"""
University Publications Pipeline
==================================
clean_minio
  >> extract_openalex
  >> transform_publications
  >> index_publications
  >> done
"""

import sys
import os
from datetime import datetime, timedelta

sys.path.insert(0, "/opt/airflow")

from airflow import DAG
from airflow.operators.python import PythonOperator
from airflow.operators.bash import BashOperator
from airflow.operators.empty import EmptyOperator

default_args = {
    "owner": "data-platform",
    "retries": 1,
    "retry_delay": timedelta(minutes=5),
}

SPARK_SUBMIT   = "/home/airflow/.local/bin/spark-submit"
JOBS_ROOT      = "/opt/airflow/jobs"
PYSPARK_PYTHON = "/home/airflow/.local/bin/python3"

SPARK_CONF = (
    "--master local[2] "
    "--driver-memory 512m "
    "--executor-memory 512m "
    "--conf spark.sql.hive.metastore.uris=thrift://hive-metastore:9083 "
    "--conf spark.hadoop.hive.metastore.uris=thrift://hive-metastore:9083 "
    "--conf spark.hadoop.fs.s3a.endpoint=http://minio:9000 "
    "--conf spark.hadoop.fs.s3a.path.style.access=true "
    "--conf spark.hadoop.fs.s3a.impl=org.apache.hadoop.fs.s3a.S3AFileSystem "
    "--conf spark.hadoop.fs.s3a.connection.ssl.enabled=false "
    "--conf spark.serializer=org.apache.spark.serializer.KryoSerializer "
    "--conf spark.sql.extensions=org.apache.spark.sql.hudi.HoodieSparkSessionExtension "
    "--conf spark.sql.catalog.spark_catalog=org.apache.spark.sql.hudi.catalog.HoodieCatalog "
)


def _spark_env():
    return {
        "PYTHONPATH":            "/opt/airflow",
        "PYSPARK_PYTHON":        PYSPARK_PYTHON,
        "PYSPARK_DRIVER_PYTHON": PYSPARK_PYTHON,
        "AWS_ACCESS_KEY_ID":     os.environ.get("MINIO_ROOT_USER", ""),
        "AWS_SECRET_ACCESS_KEY": os.environ.get("MINIO_ROOT_PASSWORD", ""),
        "MINIO_ENDPOINT":        os.environ.get("MINIO_ENDPOINT", "http://minio:9000"),
        "MINIO_ROOT_USER":       os.environ.get("MINIO_ROOT_USER", ""),
        "MINIO_ROOT_PASSWORD":   os.environ.get("MINIO_ROOT_PASSWORD", ""),
        "MINIO_RAW_BUCKET_JSON": os.environ.get("MINIO_RAW_BUCKET_JSON", "raw-json-dev"),
        "MINIO_CURATED_BUCKET":  os.environ.get("MINIO_CURATED_BUCKET", "curated"),
        "ELASTIC_HOST":          "http://elasticsearch:9200",
        "APP_ENV":               os.environ.get("APP_ENV", "dev"),
    }


def _clean_minio():
    """Vide le bucket raw-json-dev/openalex/ avant chaque run."""
    import boto3
    from botocore.client import Config
    from jobs.common.logger import logger

    endpoint  = os.environ.get("MINIO_ENDPOINT", "http://minio:9000")
    user      = os.environ.get("MINIO_ROOT_USER", "")
    password  = os.environ.get("MINIO_ROOT_PASSWORD", "")
    bucket    = os.environ.get("MINIO_RAW_BUCKET_JSON", "raw-json-dev")
    prefix    = "openalex/"

    logger.info(f"🧹 Nettoyage MinIO : s3://{bucket}/{prefix}")

    s3 = boto3.client(
        "s3",
        endpoint_url=endpoint,
        aws_access_key_id=user,
        aws_secret_access_key=password,
        config=Config(signature_version="s3v4"),
    )

    paginator = s3.get_paginator("list_objects_v2")
    deleted = 0
    for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
        objects = page.get("Contents", [])
        if objects:
            s3.delete_objects(
                Bucket=bucket,
                Delete={"Objects": [{"Key": o["Key"]} for o in objects]},
            )
            deleted += len(objects)

    logger.success(f"✅ {deleted} objets supprimés de s3://{bucket}/{prefix}")


def _run_openalex():
    """Ingestion OpenAlex -> MinIO bronze zone."""
    from jobs.common.logger import logger
    from jobs.ingestion.api.extract_all import run_openalex_ingestion

    logger.info("=" * 60)
    logger.info("🚀 EXTRACT OPENALEX START")
    logger.info("=" * 60)

    run_openalex_ingestion(institution_id="I99297268", limit=5)

    logger.success("✅ EXTRACT OPENALEX DONE")


with DAG(
    dag_id="university_publications_pipeline",
    description="MinIO clean → OpenAlex → Spark transform → Elasticsearch",
    default_args=default_args,
    schedule="@daily",
    start_date=datetime(2026, 7, 1),
    catchup=False,
    max_active_runs=1,
    tags=["publications", "openalex", "spark", "elasticsearch"],
) as dag:

    # 0. Nettoyage MinIO
    clean_minio = PythonOperator(
        task_id="clean_minio",
        python_callable=_clean_minio,
    )

    # 1. Ingestion OpenAlex
    extract_openalex = PythonOperator(
        task_id="extract_openalex",
        python_callable=_run_openalex,
    )

    # 2. Transformation Spark -> Hudi
    transform_publications = BashOperator(
        task_id="transform_publications",
        bash_command=(
            f"echo '🔄 START transform_publications' && "
            f"{SPARK_SUBMIT} {SPARK_CONF}"
            f"{JOBS_ROOT}/transformation/pipelines/transform_publications.py && "
            f"echo '✅ DONE transform_publications'"
        ),
        env=_spark_env(),
    )

    # 3. Indexation Elasticsearch
    index_publications = BashOperator(
        task_id="index_publications",
        bash_command=(
            f"echo '🔄 START index_publications' && "
            f"{SPARK_SUBMIT} {SPARK_CONF}"
            f"{JOBS_ROOT}/indexing/index_publications.py && "
            f"echo '✅ DONE index_publications'"
        ),
        env=_spark_env(),
    )

    done = EmptyOperator(task_id="done")

    # Pipeline
    clean_minio >> extract_openalex >> transform_publications >> index_publications >> done